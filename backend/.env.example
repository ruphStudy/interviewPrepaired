# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/interview-coach
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/interview-coach

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# AI provider foundation — only 'openai' is actually implemented today.
AI_PROVIDER=openai

# Optional per-operation model routing overrides (all optional). Fallback order
# per operation: operation-specific var -> AI_MODEL_DEFAULT -> OPENAI_MODEL.
# Leave unset to keep current behavior unchanged.
# AI_MODEL_DEFAULT=
# AI_MODEL_QUESTION=
# AI_MODEL_EVALUATION=
# AI_MODEL_REPORT=

# USD -> INR conversion rate used ONLY for displaying AI cost figures in INR
# alongside the actual USD cost; not a live/exact FX rate. Falls back to 95
# if unset or invalid.
USD_TO_INR=95

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# B2C Billing / Payment Provider (PR-BILL) — leave the secrets blank in any
# non-production environment; checkout/verify/webhook endpoints respond with
# PAYMENT_PROVIDER_UNAVAILABLE until real values are set. Never commit real
# credentials here.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public application URLs — used for receipt display, password-reset/
# invitation email links, and any future provider callback links. Never
# construct these links from a request Host header.
APP_BASE_URL=
FRONTEND_URL=http://localhost:5173

# Transactional Email Provider (PR-COMM) — leave RESEND_API_KEY/EMAIL_FROM
# blank in any environment without a real provider; forgot-password/
# invitation emails then queue for retry and surface
# EMAIL_PROVIDER_UNAVAILABLE internally rather than faking success. Never
# commit real credentials here.
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=EnterSkill
EMAIL_REPLY_TO=
RESEND_API_KEY=
# Resend's webhook signing secret (Svix format, starts with "whsec_") — required for /api/v1/webhooks/email/resend.
EMAIL_WEBHOOK_SECRET=
# Local/dev-only convenience: console-logs "would have sent" instead of a
# real send. Ignored entirely when NODE_ENV=production — see emails/index.ts.
EMAIL_DEV_MODE=false

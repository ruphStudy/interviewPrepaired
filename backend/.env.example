# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/interview-coach
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/interview-coach

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# AI provider foundation — only 'openai' is actually implemented today.
AI_PROVIDER=openai

# Optional per-operation model routing overrides (all optional). Fallback order
# per operation: operation-specific var -> AI_MODEL_DEFAULT -> OPENAI_MODEL.
# Leave unset to keep current behavior unchanged.
# AI_MODEL_DEFAULT=
# AI_MODEL_QUESTION=
# AI_MODEL_EVALUATION=
# AI_MODEL_REPORT=

# USD -> INR conversion rate used ONLY for displaying AI cost figures in INR
# alongside the actual USD cost; not a live/exact FX rate. Falls back to 95
# if unset or invalid.
USD_TO_INR=95

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# B2C Billing / Payment Provider (PR-BILL) — leave the secrets blank in any
# non-production environment; checkout/verify/webhook endpoints respond with
# PAYMENT_PROVIDER_UNAVAILABLE until real values are set. Never commit real
# credentials here.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Organization (B2B) billing receipt merchant display fields (PR-B2B-BILL) —
# optional, never fabricated. Leave blank unless genuinely configured; every
# receipt stays labelled "Payment Receipt" (never "Tax Invoice") regardless.
BILLING_LEGAL_NAME=
BILLING_ADDRESS=
BILLING_GSTIN=

# Public application URLs — used for receipt display, password-reset/
# invitation email links, and any future provider callback links. Never
# construct these links from a request Host header.
APP_BASE_URL=
FRONTEND_URL=http://localhost:5173

# Transactional Email Provider (PR-COMM) — leave RESEND_API_KEY/EMAIL_FROM
# blank in any environment without a real provider; forgot-password/
# invitation emails then queue for retry and surface
# EMAIL_PROVIDER_UNAVAILABLE internally rather than faking success. Never
# commit real credentials here.
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=EnterSkill
EMAIL_REPLY_TO=
RESEND_API_KEY=
# Resend's webhook signing secret (Svix format, starts with "whsec_") — required for /api/v1/webhooks/email/resend.
EMAIL_WEBHOOK_SECRET=
# Local/dev-only convenience: console-logs "would have sent" instead of a
# real send. Ignored entirely when NODE_ENV=production — see emails/index.ts.
EMAIL_DEV_MODE=false

# Object Storage (PR-STORAGE) — durable private files (resumes, knowledge-base
# documents). STORAGE_PROVIDER=local is a filesystem provider for local
# development/tests ONLY — it is refused at startup when NODE_ENV=production
# (see storage/index.ts). Set STORAGE_PROVIDER=s3 with real bucket/credentials
# for any real deployment; an S3-compatible endpoint (Cloudflare R2, MinIO,
# etc) may be used via STORAGE_ENDPOINT + STORAGE_FORCE_PATH_STYLE=true.
# Never commit real credentials here.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_SIGNED_URL_TTL_SECONDS=600
LOCAL_STORAGE_PATH=./storage-dev

# Optional error monitoring (PR-OPS-3) — leave SENTRY_DSN blank to keep
# monitoring a safe no-op everywhere in the app. Never commit a real DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Express `trust proxy` setting (PR-OPS-6) — leave blank to keep Express's
# default (disabled). Only set this if this process actually sits behind a
# reverse proxy/load balancer you control (e.g. 'true', '1', or a
# comma-separated list of trusted subnets).
TRUST_PROXY=

# When 'false', this process does NOT start the in-process email/job
# pollers — a separate `worker` process (npm run worker) is expected to run
# them instead. Leave as 'true' (or unset) for a single-process deployment.
RUN_JOBS_IN_PROCESS=true

# Local backup/restore tooling (PR-OPS-5) — see scripts/db-*.sh. Real backup
# SCHEDULING and durable off-machine storage of the resulting archives are
# infrastructure outside this repo.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Critical safeguard — a restore script refuses to run in production unless
# this is explicitly set to 'true'. Never set to true casually.
ALLOW_PRODUCTION_RESTORE=false

# Privacy / consent foundation (PR-PRIVACY-4). Versions are just labels
# (bump when the real document changes). URLs MUST stay blank unless a
# real, legal-review-confirmed Terms/Privacy Policy document exists — never
# fabricated/placeholder links.
TERMS_VERSION=1.0
PRIVACY_POLICY_VERSION=1.0
TERMS_URL=
PRIVACY_POLICY_URL=
# Hours a completed data-export archive stays downloadable before cleanup deletes it.
PRIVACY_EXPORT_RETENTION_HOURS=48
